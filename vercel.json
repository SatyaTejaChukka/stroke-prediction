{
  "version": 2,
  "cleanUrls": true,
  "buildCommand": "node build.js",
  "outputDirectory": "frontend",
  "rewrites": [
    {
      "source": "/api/config",
      "destination": "/api/config.js"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
